rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====================================================================
    //  ADMIN-FREIGABE — nur diese E-Mail-Adresse(n) dürfen schreiben und
    //  Kundendaten (Anfragen/Rückrufe/Abonnenten) sehen.
    //  WICHTIG: Trage hier GENAU die E-Mail ein, mit der du dich im Admin
    //  anmeldest. Weitere Admins mit Komma ergänzen, z. B.:
    //    ["doris@it-market.at", "andreas@it-market.at"]
    // ====================================================================
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ["office@it-market.at", "andreas@it-market.at"];
    }

    // --- Shop-Daten (Produkte, Kategorien, Blog, Reviews, Konfigurator, Logo) ---
    // Lesen: öffentlich (Website muss Produkte laden). Schreiben: nur Admin.
    match /shop_data/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Newsletter-Abonnenten (Double-Opt-In) ---
    // Anmelden (create) + Bestätigen (get/update) offen; Liste/Löschen nur Admin.
    match /newsletter_subscribers/{subscriberId} {
      allow get, create, update: if true;
      allow list, delete: if isAdmin();
    }

    // --- Angebotsanfragen (Kundendaten) ---
    // Absenden (create) offen; Lesen/Ändern/Löschen nur Admin.
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // --- Rückruf-Wünsche (Kundendaten) ---
    match /callbacks/{callbackId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // --- Eigener anonymer Seitenzähler (nur aggregierte Zahlen, keine
    //     personenbezogenen Daten). Besucher dürfen hochzählen, nur Admin liest. ---
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if true;
    }
  }
}
