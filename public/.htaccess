# ============================================================
#  IT-MARKET  ·  Hostinger Static Hosting Konfiguration
#  Wird von Vite automatisch nach dist/ kopiert und landet
#  beim Deploy in /public_html/.htaccess
# ============================================================

# --- HTTPS erzwingen ---------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- www -> non-www (it-market.at ist die Hauptdomain) -----
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# --- Trailing Slash: einheitlich MIT "/" ------------------
# Die vorgerenderten Seiten sind Ordner (/produkt/<slug>/index.html); LiteSpeed
# (DirectorySlash) haengt bei Ordner-Aufrufen automatisch ein "/" an. Canonical,
# Sitemap und interne Links zeigen ebenfalls auf die Variante MIT "/", daher hier
# KEINE Slash-Entfernung mehr (das erzeugte sonst widerspruechliche 301-Signale).

# --- Alte WordPress/Yoast-Sitemaps sind entfernt -> 410 Gone (statt SPA-HTML) ---
# (betrifft NICHT die aktuelle /sitemap.xml)
RewriteRule ^sitemap_index\.xml$ - [G]
RewriteRule ^[a-z0-9_-]+-sitemap[0-9]*\.xml$ - [G]

# --- Echte 404-Seite statt Soft-404 -----------------------
# Alle oeffentlichen Seiten sind als echte Dateien/Ordner vorgerendert und werden
# direkt ausgeliefert. Deshalb KEIN Catch-all-Fallback auf index.html mehr:
# unbekannte URLs liefern jetzt einen echten HTTP-404 mit freundlicher Fehlerseite.
# (Warenkorb/Admin sind keine eigenen Pfade; die Newsletter-Bestaetigung laeuft
#  ueber "/" mit ?confirm_newsletter=… und funktioniert weiterhin.)
ErrorDocument 404 /404.html

# --- Caching statischer Assets (gehashte Dateinamen) -------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  # HTML nie dauerhaft cachen, damit Updates sofort erscheinen
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Kompression -------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# --- Sicherheits-Header ------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
